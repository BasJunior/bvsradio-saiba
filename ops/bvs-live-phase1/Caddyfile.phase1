# BVS Live Phase 1 — beta media-origin HTTP layer only.
# HAProxy owns public TLS/443 and forwards decrypted HTTP for stream-beta here.
# Caddy also injects the SRS hook bearer on a separate loopback listener.
# Do not use production BVS hostnames in this file.

http://127.0.0.1:8081 {
    @wrongHost not host stream-beta.bvsradio.com
    respond @wrongHost 421

    # HLS is public/unlisted in Phase 1. CORS allows the beta BVS web origin only.
    header {
        Access-Control-Allow-Origin "https://bvsradio-beta.vercel.app"
        Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        Access-Control-Allow-Headers "Range"
        Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges"
        Vary "Origin"
        X-Content-Type-Options "nosniff"
    }

    @preflight method OPTIONS
    respond @preflight 204

    reverse_proxy 127.0.0.1:8080
}

# SRS calls this loopback-only listener. Never expose TCP/9080 publicly.
http://127.0.0.1:9080 {
    @hooks path /api/live/srs/on-publish /api/live/srs/on-unpublish

    reverse_proxy @hooks https://bvsradio-beta.vercel.app {
        header_up Host bvsradio-beta.vercel.app
        header_up Authorization "Bearer {$BVS_LIVE_HOOK_SECRET}"
        header_up X-BVS-Live-Relay "phase1-origin"
    }

    respond 404
}
