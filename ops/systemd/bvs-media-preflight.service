[Unit]
Description=BVS private media preflight worker
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace/bvsradio
EnvironmentFile=%h/.openclaw/secrets/bvs-supabase-db.env
EnvironmentFile=%h/.openclaw/secrets/bvs-r2.env
ExecStart=/usr/bin/python3 %h/.openclaw/workspace/bvsradio/scripts/media-preflight-worker.py --limit 3
TimeoutStartSec=900

